FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY requirements-gcs.txt ./requirements-gcs.txt

RUN pip install --no-cache-dir -r requirements-gcs.txt

COPY src ./src

CMD ["uvicorn", "hikorobo_gcs.server.app:app", \
     "--host", "0.0.0.0", \
     "--port", "8000"]