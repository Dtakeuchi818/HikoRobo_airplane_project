# Read and validate the build-time defaults. Can also run via cmake -P for checks.
function(sbus_defaults_integer output min max)
    string(JSON value GET "${sbus_json}" ${ARGN})
    string(JSON type TYPE "${sbus_json}" ${ARGN})
    if(NOT type STREQUAL "NUMBER" OR NOT value MATCHES "^-?(0|[1-9][0-9]*)$"
       OR value LESS min OR value GREATER max)
        string(JOIN "." field ${ARGN})
        message(FATAL_ERROR "${sbus_config}: ${field} must be an integer between ${min} and ${max}")
    endif()
    # Emit a canonical decimal literal for the compiler.
    math(EXPR value "${value}")
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(sbus_defaults_angle output min max ch mode index)
    set(field "${mode}_deg")
    string(JSON type ERROR_VARIABLE error TYPE "${sbus_json}" channels CH${ch} "${field}")
    if(error AND type STREQUAL "channels-CH${ch}-${field}-NOTFOUND")
        set(field "${mode}_centideg")
        sbus_defaults_array(2 channels CH${ch} "${field}")
        sbus_defaults_integer(value ${min} ${max} channels CH${ch} "${field}" ${index})
        set(${output} "${value}" PARENT_SCOPE)
        return()
    endif()

    sbus_defaults_array(2 channels CH${ch} "${field}")
    string(JSON type TYPE "${sbus_json}" channels CH${ch} "${field}" ${index})
    string(JSON degrees GET "${sbus_json}" channels CH${ch} "${field}" ${index})
    set(label "${sbus_config}: channels.CH${ch}.${field}.${index}")
    if(NOT type STREQUAL "NUMBER" OR degrees LESS -180 OR degrees GREATER 180
       OR NOT degrees MATCHES "^(-?)([0-9]+)(\\.([0-9]+))?$")
        message(FATAL_ERROR "${label} must be a number in degrees within ±180")
    endif()
    set(sign "${CMAKE_MATCH_1}")
    set(whole "${CMAKE_MATCH_2}")
    # CMake's JSON parser can render 0.29 as 0.28999999999999998.
    string(SUBSTRING "${CMAKE_MATCH_4}000" 0 3 fraction)
    math(EXPR value "${whole} * 100 + (1${fraction} - 1000 + 5) / 10")
    math(EXPR canonical_whole "${value} / 100")
    math(EXPR canonical_fraction "${value} % 100")
    if(canonical_fraction LESS 10)
        set(canonical_fraction "0${canonical_fraction}")
    endif()
    if(NOT degrees EQUAL "${sign}${canonical_whole}.${canonical_fraction}")
        message(FATAL_ERROR "${label} must have at most two decimal places")
    endif()
    if(sign STREQUAL "-")
        math(EXPR value "-${value}")
    endif()
    if(value LESS min OR value GREATER max)
        message(FATAL_ERROR "${label} has the wrong sign for this angle limit")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(sbus_defaults_array count)
    string(JSON type TYPE "${sbus_json}" ${ARGN})
    string(JSON length LENGTH "${sbus_json}" ${ARGN})
    if(NOT type STREQUAL "ARRAY" OR NOT length EQUAL count)
        string(JOIN "." field ${ARGN})
        message(FATAL_ERROR "${sbus_config}: ${field} must be an array of ${count} values")
    endif()
endfunction()

function(sbus_generate_defaults sbus_config output)
    file(READ "${sbus_config}" sbus_json)
    string(JSON axes_type ERROR_VARIABLE axes_error TYPE "${sbus_json}" attitude_axes)
    if(axes_error AND axes_type STREQUAL "attitude_axes-NOTFOUND")
        set(roll 1)
        set(pitch 2)
        set(yaw 4)
    else()
        sbus_defaults_integer(roll 1 8 attitude_axes roll)
        sbus_defaults_integer(pitch 1 8 attitude_axes pitch)
        sbus_defaults_integer(yaw 1 8 attitude_axes yaw)
        if(roll EQUAL pitch OR roll EQUAL yaw OR pitch EQUAL yaw)
            message(FATAL_ERROR "${sbus_config}: attitude_axes must use three distinct channels")
        endif()
    endif()
    file(CONFIGURE OUTPUT "${output}.axes" CONTENT "{${roll}, ${pitch}, ${yaw}}\n" @ONLY)
    sbus_defaults_integer(switch_ch 0 8 mode switch_channel)
    sbus_defaults_array(2 mode surface_raw)
    sbus_defaults_array(2 mode attitude_raw)
    sbus_defaults_integer(surface_min 0 2047 mode surface_raw 0)
    sbus_defaults_integer(surface_max 0 2047 mode surface_raw 1)
    sbus_defaults_integer(attitude_min 0 2047 mode attitude_raw 0)
    sbus_defaults_integer(attitude_max 0 2047 mode attitude_raw 1)
    if(surface_min GREATER surface_max OR attitude_min GREATER attitude_max
       OR (surface_max GREATER_EQUAL attitude_min AND attitude_max GREATER_EQUAL surface_min))
        message(FATAL_ERROR "${sbus_config}: mode ranges must be ordered and disjoint")
    endif()

    set(initializer "{\n    .mode = {${switch_ch}, ${surface_min}, ${surface_max}, ${attitude_min}, ${attitude_max}},\n    .channel = {\n")
    foreach(ch RANGE 1 8)
        sbus_defaults_angle(surface_min -18000 0 ${ch} surface 0)
        sbus_defaults_angle(surface_max 0 18000 ${ch} surface 1)
        sbus_defaults_angle(attitude_min -18000 0 ${ch} attitude 0)
        sbus_defaults_angle(attitude_max 0 18000 ${ch} attitude 1)
        string(APPEND initializer "        {${surface_min}, ${surface_max}, ${attitude_min}, ${attitude_max}}, /* CH${ch} */\n")
    endforeach()
    string(APPEND initializer "    },\n}\n")
    file(CONFIGURE OUTPUT "${output}" CONTENT "${initializer}" @ONLY)
endfunction()
